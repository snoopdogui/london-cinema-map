# MovieGlu API — https://developer.movieglu.com
# Copy this file to .env.local and fill in your own values.
MOVIEGLU_CLIENT=
MOVIEGLU_API_KEY=
MOVIEGLU_AUTH=
MOVIEGLU_TERRITORY=

# Feedback form email (iCloud SMTP — use an app-specific password, not your
# Apple ID password). Optional: the form is only enabled when these are set.
FEEDBACK_EMAIL_USER=
FEEDBACK_EMAIL_PASS=
